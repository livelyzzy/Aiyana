# ============ 基础配置 ============
APP_NAME=AI实训评价系统
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1

# ============ 安全 / 认证 ============
# 生产环境务必替换为随机长字符串
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ 数据库 ============
# 默认使用 SQLite；切换 PostgreSQL 时改为此格式：
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/aiyana
DATABASE_URL=sqlite+aiosqlite:///./data/aiyana.db

# ============ 大模型 Provider ============
# 可选值：ollama（本地） / openai（云端，OpenAI 兼容）
LLM_PROVIDER=ollama

# --- 本地 Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- 云端（OpenAI 兼容，可对接 OpenAI / 通义千问 / DeepSeek 等）---
# 通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek：https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini

# ============ 文件上传 ============
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# ============ 报表输出 ============
REPORT_DIR=./reports

# ============ CORS（前端地址）============
CORS_ORIGINS=http://localhost:5173
